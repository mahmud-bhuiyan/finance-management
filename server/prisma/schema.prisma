generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Placeholder model for Step 01 connectivity check.
model HealthCheck {
  id        String   @id @default(cuid())
  note      String   @default("ok")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("health_checks")
}

enum UserRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  NORMAL_USER
}

enum TenantStatus {
  ACTIVE
  INACTIVE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

/// Company / tenant (Step 03). Super Admin has no tenant.
model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  users     User[]
  auditLogs AuditLog[]

  @@map("tenants")
}

/// Auth user. Super Admin: tenantId is null. Company users belong to one tenant.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String?
  role         UserRole  @default(NORMAL_USER)
  tenantId     String?   @map("tenant_id")
  tenant       Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  auditLogs    AuditLog[] @relation("AuditActor")

  @@index([tenantId])
  @@map("users")
}

/// Immutable audit trail for create/update/delete (Step 05).
model AuditLog {
  id         String      @id @default(cuid())
  tenantId   String?     @map("tenant_id")
  tenant     Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  actorId    String      @map("actor_id")
  actor      User        @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  action     AuditAction
  entityType String      @map("entity_type")
  entityId   String      @map("entity_id")
  oldValues  Json?       @map("old_values")
  newValues  Json?       @map("new_values")
  createdAt  DateTime    @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}
