generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Placeholder model for Step 01 connectivity check.
model HealthCheck {
  id        String   @id @default(cuid())
  note      String   @default("ok")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("health_checks")
}

enum UserRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  NORMAL_USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum TenantStatus {
  ACTIVE
  INACTIVE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

enum FieldTarget {
  EXPENSE
  INCOME
}

enum FieldType {
  TEXT
  LONG_TEXT
  NUMBER
  CURRENCY
  DATE
  BOOLEAN
  DROPDOWN
  FILE
}

enum TransactionType {
  EXPENSE
  INCOME
}

/// How an expense/income was paid (Step 12 dashboard filter + charts).
enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  CHECK
  OTHER
}

/// Company / tenant (Step 03). Super Admin has no tenant.
model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  users                   User[]
  auditLogs               AuditLog[]
  fieldDefinitions        FieldDefinition[]
  financialTransactions   FinancialTransaction[]
  expenseCategories       ExpenseCategory[]
  departments             Department[]
  vendors                 Vendor[]
  expenseAttachments      ExpenseAttachment[]

  @@map("tenants")
}

/// Auth user. Super Admin: tenantId is null. Company users belong to one tenant.
model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  name         String?
  role         UserRole   @default(NORMAL_USER)
  status       UserStatus @default(ACTIVE)
  tenantId     String?    @map("tenant_id")
  tenant       Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  auditLogs             AuditLog[] @relation("AuditActor")
  createdTransactions   FinancialTransaction[] @relation("TransactionCreator")
  uploadedAttachments   ExpenseAttachment[] @relation("AttachmentUploader")

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("users")
}

/// Immutable audit trail for create/update/delete (Step 05).
model AuditLog {
  id         String      @id @default(cuid())
  tenantId   String?     @map("tenant_id")
  tenant     Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  actorId    String      @map("actor_id")
  actor      User        @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  action     AuditAction
  entityType String      @map("entity_type")
  entityId   String      @map("entity_id")
  oldValues  Json?       @map("old_values")
  newValues  Json?       @map("new_values")
  createdAt  DateTime    @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

/// Tenant-scoped custom field definition (Step 06). Reused across expense/income modules.
model FieldDefinition {
  id                  String      @id @default(cuid())
  tenantId            String      @map("tenant_id")
  tenant              Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  target              FieldTarget
  key                 String
  label               String
  fieldType           FieldType   @map("field_type")
  required            Boolean     @default(false)
  enabled             Boolean     @default(true)
  sortOrder           Int         @default(0) @map("sort_order")
  options             Json?
  showInReports       Boolean     @default(true) @map("show_in_reports")
  visibleToNormalUser Boolean     @default(false) @map("visible_to_normal_user")
  defaultValue        Json?       @map("default_value")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  @@unique([tenantId, target, key])
  @@index([tenantId, target, enabled, sortOrder])
  @@map("field_definitions")
}

/// Tenant expense category lookup (Step 09).
model ExpenseCategory {
  id         String                 @id @default(cuid())
  tenantId   String                 @map("tenant_id")
  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  name       String
  notes      String?
  active     Boolean                @default(true)
  deletedAt  DateTime?              @map("deleted_at")
  createdAt  DateTime               @default(now()) @map("created_at")
  updatedAt  DateTime               @updatedAt @map("updated_at")
  transactions FinancialTransaction[]

  @@index([tenantId, deletedAt, active, name])
  @@map("expense_categories")
}

/// Tenant department lookup (Step 09).
model Department {
  id         String                 @id @default(cuid())
  tenantId   String                 @map("tenant_id")
  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  name       String
  notes      String?
  active     Boolean                @default(true)
  deletedAt  DateTime?              @map("deleted_at")
  createdAt  DateTime               @default(now()) @map("created_at")
  updatedAt  DateTime               @updatedAt @map("updated_at")
  transactions FinancialTransaction[]

  @@index([tenantId, deletedAt, active, name])
  @@map("departments")
}

/// Tenant vendor / payee lookup (Step 09).
model Vendor {
  id         String                 @id @default(cuid())
  tenantId   String                 @map("tenant_id")
  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  name       String
  notes      String?
  active     Boolean                @default(true)
  deletedAt  DateTime?              @map("deleted_at")
  createdAt  DateTime               @default(now()) @map("created_at")
  updatedAt  DateTime               @updatedAt @map("updated_at")
  transactions FinancialTransaction[]

  @@index([tenantId, deletedAt, active, name])
  @@map("vendors")
}

/// Shared ledger row (Step 08). Income CRUD reuses this in Step 14 (`type=INCOME`).
model FinancialTransaction {
  id           String           @id @default(cuid())
  tenantId     String           @map("tenant_id")
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  type         TransactionType
  occurredOn   DateTime         @map("occurred_on") @db.Date
  amount        Decimal          @db.Decimal(19, 2)
  notes         String?
  paymentMethod PaymentMethod?   @map("payment_method")
  customValues  Json             @default("{}") @map("custom_values")
  categoryId    String?          @map("category_id")
  category      ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  departmentId  String?          @map("department_id")
  department    Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  vendorId      String?          @map("vendor_id")
  vendor        Vendor?          @relation(fields: [vendorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  deletedAt     DateTime?        @map("deleted_at")
  createdById   String           @map("created_by_id")
  createdBy     User             @relation("TransactionCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  attachments   ExpenseAttachment[]

  @@index([tenantId, type, deletedAt, occurredOn])
  @@index([categoryId])
  @@index([departmentId])
  @@index([vendorId])
  @@index([paymentMethod])
  @@map("financial_transactions")
}

/// Receipt / file attached to an expense (Step 10). Bytes live on disk (or S3 later); DB holds metadata.
model ExpenseAttachment {
  id            String               @id @default(cuid())
  tenantId      String               @map("tenant_id")
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  transactionId String               @map("transaction_id")
  transaction   FinancialTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  originalName  String               @map("original_name")
  mimeType      String               @map("mime_type")
  sizeBytes     Int                  @map("size_bytes")
  storageKey    String               @map("storage_key")
  deletedAt     DateTime?            @map("deleted_at")
  createdById   String               @map("created_by_id")
  createdBy     User                 @relation("AttachmentUploader", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt     DateTime             @default(now()) @map("created_at")

  @@index([tenantId, transactionId, deletedAt])
  @@map("expense_attachments")
}
