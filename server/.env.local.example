# Copy this file to .env.local and edit. The server loads .env.local only.
# Do not commit .env.local.

PORT=4000

# -----------------------------------------------------------------------------
# PostgreSQL — check / start locally (Windows) before migrate / npm run dev
# -----------------------------------------------------------------------------
# 1) Is the service running?
#    PowerShell:  Get-Service *postgres*
#    Expect Status = Running. If Stopped: Start-Service <exact-name>
#    Or open services.msc → find PostgreSQL → Start
#
# 2) Is port 5432 listening?
#    netstat -ano | findstr :5432
#    Expect a LISTENING line
#
# 3) Can you connect with psql? (if psql is on PATH)
#    psql -U postgres -c "SELECT version();"
#    Enter your postgres password when prompted
#
# 4) Create the database once (if it does not exist yet)
#    psql -U postgres -c "CREATE DATABASE fms_dev;"
#
# 5) Confirm from this app after server is up
#    GET http://localhost:4000/health
#    Expect database.connected: true
#
# DATABASE_URL format:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fms_dev?schema=public"

# SPA origin (CORS). Local: Vite. Production: the deployed client origin, no trailing slash.
# On Vercel, set this to https://mrb-finance-management.vercel.app
CLIENT_URL="http://localhost:5173"

# -----------------------------------------------------------------------------
# Auth (Step 02) — set a long random string locally (min 32 chars)
# Do not commit real secrets. Generate your own value for JWT_SECRET.
# -----------------------------------------------------------------------------
JWT_SECRET="replace-with-a-long-random-dev-secret-at-least-32-chars"
JWT_EXPIRES_IN="7d"
JWT_COOKIE_NAME="fms_token"
JWT_COOKIE_MAX_AGE_MS=604800000

# -----------------------------------------------------------------------------
# Super Admin bootstrap (Step 03)
# On server start, creates this user if the email does not exist yet.
# Super Admin has no tenant and can manage companies + company admins.
# -----------------------------------------------------------------------------
SUPER_ADMIN_EMAIL="superadmin@fms.local"
SUPER_ADMIN_PASSWORD="password123"
SUPER_ADMIN_NAME="Super Admin"

# -----------------------------------------------------------------------------
# File uploads (Step 10) — local disk for now; authenticated download only
# -----------------------------------------------------------------------------
# Relative paths resolve from the server process cwd (usually server/).
UPLOAD_DIR="./uploads"
UPLOAD_MAX_BYTES=5242880
UPLOAD_MAX_PER_EXPENSE=5

# -----------------------------------------------------------------------------
# Automated tests (Step 18) — from server/: npm test
# Tests rewrite DATABASE_URL to database fms_test (created automatically).
# They never truncate fms_dev.
# -----------------------------------------------------------------------------
