generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Placeholder model for Step 01 connectivity check.
/// Real domain models (tenants, users, transactions, fields) start in later steps.
model HealthCheck {
  id        String   @id @default(cuid())
  note      String   @default("ok")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("health_checks")
}
