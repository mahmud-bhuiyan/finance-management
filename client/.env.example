# Client uses this file only (client/.env). Do not add .env.local.
# Public values only. Never put JWT_SECRET or DATABASE_URL here.
# Vite exposes only variables prefixed with VITE_.

# Local dev: leave empty. The app calls /api/v1 and Vite proxies to the server.
VITE_API_URL=

# Production / preview (cross-origin). No trailing slash.
# Set this in the Vercel client project (Build + Runtime), then redeploy.
# VITE_API_URL=https://mrb-finance-management-server.vercel.app
